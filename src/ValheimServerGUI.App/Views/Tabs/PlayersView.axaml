<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.PlayersView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
            <Button Grid.Column="0" Content="View Player Details…" Command="{Binding Players.ViewDetailsCommand}" />
            <c:HyperlinkLabel Grid.Column="2" Text="Character names wrong? Click here."
                              Command="{Binding CharacterNamesHelpCommand}" VerticalAlignment="Center" />
        </Grid>

        <c:DataListView ItemsSource="{Binding Players.Players}"
                        SelectedItem="{Binding Players.SelectedPlayer}">
            <c:DataListView.Styles>
                <Style Selector="DataGridRow" x:DataType="vm:PlayerRowViewModel">
                    <Setter Property="Opacity"
                            Value="{Binding IsOffline, Converter={x:Static conv:OfflineOpacityConverter.Instance}}" />
                </Style>
                <!-- A selected row is shown at full strength even when offline (the dim is only a
                     background cue, so the selection stays legible at the standard font colour). -->
                <Style Selector="DataGridRow:selected" x:DataType="vm:PlayerRowViewModel">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </c:DataListView.Styles>
            <c:DataListView.Columns>
                <!-- Platform icon is a prefix of the name (its own column was collapsed here); the column
                     still sorts by the plain DisplayName so the icon doesn't affect ordering. -->
                <DataGridTemplateColumn Header="Player (Character)" Width="*" SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0" VerticalAlignment="Center">
                                <Image Source="{Binding PlatformIcon}" Width="16" Height="16"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <TextBlock Text="{Binding DisplayName}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Status text prefixed with a glyph representing the status. -->
                <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0" VerticalAlignment="Center">
                                <Image Width="16" Height="16" VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       Source="{Binding Status, Converter={x:Static conv:PlayerStatusToIconConverter.Instance}}" />
                                <TextBlock Text="{Binding StatusText}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Since" Width="Auto" SortMemberPath="SinceText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <TextBlock Text="{Binding SinceText}" Margin="6,0" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </c:DataListView.Columns>
            <c:DataListView.FooterRight>
                <c:IconButton IconName="Cancel_16x" ToolTip.Tip="Remove player"
                              Command="{Binding Players.RemoveCommand}" />
            </c:DataListView.FooterRight>
        </c:DataListView>
    </DockPanel>
</UserControl>
