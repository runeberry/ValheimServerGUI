<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.ServerControlsView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Margin="8" Spacing="2">
            <!-- Name (wide) + Port (narrow) on one row. -->
            <Grid ColumnDefinitions="*,12,Auto">
                <c:TextFormField Grid.Column="0" LabelText="Server Name"
                                 HelpText="This is the name that will appear in the Community Servers list within Valheim."
                                 Value="{Binding Form.Name}" MaxLength="64" IsEnabled="{Binding AllowServerChanges}" />
                <c:NumericFormField Grid.Column="2" Width="110" LabelText="Port"
                                    HelpText="The UDP port to run on (1–65535). Valheim also uses the next port up."
                                    Value="{Binding Form.Port}" Minimum="1" Maximum="65535"
                                    IsEnabled="{Binding AllowServerChanges}" />
            </Grid>

            <c:TextFormField LabelText="Server Password"
                             HelpText="Your server must be protected with a password. The password must be at least 5 characters and must not contain the name of the server or the world that you're hosting."
                             Value="{Binding Form.Password}" ShowValue="{Binding Form.ShowPassword}"
                             IsEnabled="{Binding AllowServerChanges}">
                <c:TextFormField.TrailingContent>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,0,0">
                        <c:CopyButton Text="{Binding Form.Password}" ToolTip.Tip="Copy password to clipboard" />
                        <c:CheckBoxFormField LabelText="Show Password" Value="{Binding Form.ShowPassword}"
                                             IsEnabled="{Binding AllowServerChanges}" />
                    </StackPanel>
                </c:TextFormField.TrailingContent>
            </c:TextFormField>

            <!-- World | Join Options -->
            <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
                <c:GroupBox Grid.Column="0" Header="World">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                            <c:RadioFormField Grid.Column="0" GroupName="World" LabelText="Existing"
                                              Value="{Binding Form.UseNewWorld, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                                              IsEnabled="{Binding AllowServerChanges}" />
                            <c:RadioFormField Grid.Column="1" GroupName="World" LabelText="New" Margin="10,0,0,0"
                                              Value="{Binding Form.UseNewWorld}" IsEnabled="{Binding AllowServerChanges}" />
                            <c:SettingsButton Grid.Column="3" ToolTip.Tip="World Modifier Settings"
                                              Command="{Binding WorldPreferencesCommand}" />
                            <c:RefreshButton Grid.Column="4" ToolTip.Tip="Refresh the worlds list"
                                             Command="{Binding RefreshWorldsCommand}" />
                            <c:OpenButton Grid.Column="5" ToolTip.Tip="Open save folder"
                                          Command="{Binding OpenSaveFolderCommand}" />
                        </Grid>

                        <c:DropdownFormField LabelText="Select World" PlaceholderText="-- No worlds --"
                                             IsVisible="{Binding Form.UseNewWorld, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                                             ItemsSource="{Binding Form.Worlds}" Value="{Binding Form.ExistingWorld}"
                                             IsEnabled="{Binding CanSelectExistingWorld}" />
                        <c:TextFormField LabelText="New World Name" Watermark="5–20 characters"
                                         IsVisible="{Binding Form.UseNewWorld}"
                                         Value="{Binding Form.NewWorldName}" MaxLength="20"
                                         IsEnabled="{Binding AllowServerChanges}" />
                    </StackPanel>
                </c:GroupBox>

                <c:GroupBox Grid.Column="2" Header="Join Options">
                    <StackPanel Spacing="6">
                        <c:CheckBoxFormField LabelText="Community Server (Public)"
                                             HelpText="If this box is checked, your server will show up in the Community Servers list within Valheim. If not, other players will need to &quot;Join by IP&quot; to connect to your game.&#10;&#10;NOTE: It usually takes 1-2 minutes for your server to appear in the list in-game, but it can take up to 15 minutes, and rarely not show up at all. You can always &quot;Join by IP&quot; as a fallback."
                                             Value="{Binding Form.IsPublic}" IsEnabled="{Binding AllowServerChanges}" />
                        <c:CheckBoxFormField LabelText="Enable Crossplay"
                                             HelpText="Allow players on other platforms to join your game (Microsoft Store, Xbox, etc.)&#10;&#10;You may need to provide other players an Invite Code, which appears in game and in the server logs."
                                             Value="{Binding Form.Crossplay}" IsEnabled="{Binding AllowServerChanges}" />
                    </StackPanel>
                </c:GroupBox>
            </Grid>

            <!-- Start / Restart / Stop -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" HorizontalAlignment="Left">
                <Button x:Name="StartButton" Command="{Binding StartCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="{c:Icon Run_16x}" Width="16" Height="16" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Start Server" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestartButton" Command="{Binding RestartCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="{c:Icon Restart_16x}" Width="16" Height="16" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Restart Server" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Command="{Binding StopCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="{c:Icon Stop_16x}" Width="16" Height="16" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Stop Server" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
