<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels"
        xmlns:conv="using:ValheimServerGUI.App.Converters"
        xmlns:tabs="using:ValheimServerGUI.App.Views.Tabs"
        mc:Ignorable="d"
        x:Class="ValheimServerGUI.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Width="900" Height="640"
        MinWidth="500" MinHeight="371"
        Title="{Binding Title}">

    <DockPanel>
        <!-- ===== Menu ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New _Window" Command="{Binding NewWindowCommand}" />
                <MenuItem Header="New _Profile" Command="{Binding NewProfileCommand}" />
                <MenuItem Header="_Save Profile" Command="{Binding SaveProfileCommand}" />
                <MenuItem Header="Save Profile _As…" Command="{Binding SaveProfileAsCommand}" />
                <Separator />
                <MenuItem Header="_Load Profile" ItemsSource="{Binding Profiles}"
                          IsEnabled="{Binding HasProfiles}" x:CompileBindings="False">
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <MenuItem Header="_Remove Profile" ItemsSource="{Binding Profiles}"
                          IsEnabled="{Binding HasProfiles}" x:CompileBindings="False">
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Preferences…" Command="{Binding PreferencesCommand}" />
                <MenuItem Header="Set _Directories…" Command="{Binding SetDirectoriesCommand}" />
                <MenuItem Header="_Open Settings Directory…" Command="{Binding OpenSettingsDirectoryCommand}" />
                <Separator />
                <MenuItem Header="_Close" Command="{Binding CloseCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Online _Manual" Command="{Binding OnlineManualCommand}" />
                <MenuItem Header="_Port Forwarding" Command="{Binding PortForwardingCommand}" />
                <MenuItem Header="Submit a _Bug Report…" Command="{Binding BugReportCommand}" />
                <Separator />
                <MenuItem Header="Check for _Updates" Command="{Binding CheckForUpdatesCommand}" />
                <MenuItem Header="Get support in _Discord" Command="{Binding DiscordCommand}" />
                <MenuItem Header="_About…" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding ServerStatus, Converter={x:Static conv:StatusToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Classes="link" Content="{Binding UpdateStatusText}"
                        Command="{Binding UpdateLinkCommand}" />
            </Grid>
        </Border>

        <!-- ===== Always-visible server controls ===== -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="Start" Command="{Binding StartCommand}" MinWidth="80" />
            <Button Content="Restart" Command="{Binding RestartCommand}" MinWidth="80" />
            <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="80" />
        </StackPanel>

        <!-- ===== Tabs ===== -->
        <TabControl Margin="8,0,8,8" x:Name="Tabs" SelectionChanged="OnTabChanged">
            <TabItem Header="Server Controls">
                <tabs:ServerControlsView />
            </TabItem>
            <TabItem Header="Advanced Controls">
                <tabs:AdvancedControlsView />
            </TabItem>
            <TabItem Header="Server Details" x:Name="DetailsTab">
                <tabs:ServerDetailsView />
            </TabItem>
            <TabItem Header="Players" x:Name="PlayersTab">
                <tabs:PlayersView />
            </TabItem>
            <TabItem Header="Logs">
                <tabs:LogsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
