# Live integration-test config for scripts/integration.sh (tier-4 live smoke, §13 / E9).
#
# Copy this file to scripts/integration.local.env (gitignored) and fill in the paths for THIS
# machine's Steam install. integration.sh sources the copy; if it is absent, the run skips (not
# fails) with instructions. These paths are machine-specific and intentionally never committed.
#
#   cp scripts/integration.local.env.example scripts/integration.local.env
#   # then edit the values below

# Full path to the real Valheim DEDICATED SERVER binary (appid 896660). On Linux this is
# valheim_server.x86_64; its directory must also contain steamclient.so / linux64/ / steam_appid.txt.
VSG_IT_SERVER_EXE="/home/nuffle/.local/share/Steam/steamapps/common/Valheim dedicated server/valheim_server.x86_64"

# Steam install root (the folder that contains "userdata"), used to enumerate in-game (Steam Cloud)
# worlds for the cloud-import round-trip test.
VSG_IT_STEAM_ROOT="/home/nuffle/.local/share/Steam"

# Steam userdata account id under $VSG_IT_STEAM_ROOT/userdata (the numeric folder holding 892970/remote).
VSG_IT_STEAM_USERDATA_ID="41780385"

# Install dir of the Valheim GAME client (appid 892970) — recorded for reference / future client-side
# checks. Not required by the current tests.
VSG_IT_GAME_DIR="/home/nuffle/.local/share/Steam/steamapps/common/Valheim"
