<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ValheimServerGUI.Localization"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:conv="using:ValheimServerGUI.App.Converters"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        xmlns:v="using:ValheimServerGUI.App.Views"
        x:Class="ValheimServerGUI.App.Views.Dialogs.PlayerDetailsWindow"
        x:DataType="vm:PlayerDetailsViewModel"
        Title="{x:Static loc:Strings.PlayerDetails_Title}"
        SizeToContent="Height" Width="460" MinWidth="420"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="8">
        <!-- Every row carries a trailing icon-button slot (a real button, or an inactive placeholder) so
             the rows are evenly spaced and the help glyphs line up down the column. -->
        <StackPanel Spacing="2">
            <c:LabelField LabelText="{x:Static loc:Strings.PlayerDetails_Name_Label}" Value="{Binding DisplayNameOrUnknown}"
                          ValueIcon="{Binding Platform, Converter={x:Static conv:PlatformToIconConverter.Instance}}"
                          HelpText="{x:Static loc:Strings.PlayerDetails_Name_Help}">
                <c:LabelField.TrailingContent>
                    <c:EditButton x:Name="EditNameButton" ToolTip.Tip="{x:Static loc:Strings.PlayerDetails_EditName_Tip}" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="{Binding PlatformIdLabel}" Value="{Binding PlayerId}"
                          HelpText="{x:Static loc:Strings.PlayerDetails_PlatformId_Help}">
                <c:LabelField.TrailingContent>
                    <c:CopyButton Text="{Binding PlayerId}" ToolTip.Tip="{x:Static loc:Strings.PlayerDetails_CopyId_Tip}" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="{x:Static loc:Strings.PlayerDetails_ZdoId_Label}" Value="{Binding ZdoId}"
                          HelpText="{x:Static loc:Strings.PlayerDetails_ZdoId_Help}">
                <c:LabelField.TrailingContent>
                    <c:IconButton IsEnabled="False" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
        </StackPanel>

        <StackPanel Spacing="4" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Static loc:Strings.KnownCharacters_Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <c:HelpLabel HelpText="{x:Static loc:Strings.KnownCharacters_Help}" />
            </StackPanel>
            <v:KnownCharactersView DataContext="{Binding KnownCharacters}" Height="140">
                <v:KnownCharactersView.FooterRight>
                    <c:RefreshButton ToolTip.Tip="{x:Static loc:Strings.PlayerDetails_Refresh_Tip}"
                                     Command="{Binding $parent[Window].((vm:PlayerDetailsViewModel)DataContext).RefreshCommand}" />
                </v:KnownCharactersView.FooterRight>
            </v:KnownCharactersView>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="{x:Static loc:Strings.Common_Cancel}" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
