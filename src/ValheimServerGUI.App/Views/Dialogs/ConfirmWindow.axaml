<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ValheimServerGUI.App.Views.Dialogs.ConfirmWindow"
        SizeToContent="WidthAndHeight"
        MinWidth="360" MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Spacing="8" Margin="0,20,0,0">
            <Button x:Name="YesButton" Content="Yes" MinWidth="80" IsDefault="True" Click="OnYes" />
            <Button x:Name="NoButton" Content="No" MinWidth="80" IsCancel="True" Click="OnNo" />
        </StackPanel>
    </Grid>
</Window>
