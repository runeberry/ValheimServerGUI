<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             x:Class="ValheimServerGUI.App.Controls.CheckBoxFormField"
             x:Name="Root" x:CompileBindings="False">
    <!-- The field's AutomationId is forwarded to the CheckBox, the element UI automation toggles. -->
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <CheckBox IsEnabled="{Binding #Root.IsEnabled}" Content="{Binding #Root.LabelText}" IsChecked="{Binding #Root.Value, Mode=TwoWay}"
                  AutomationProperties.AutomationId="{Binding #Root.(AutomationProperties.AutomationId)}" />
        <c:HelpLabel HelpText="{Binding #Root.HelpText}" />
    </StackPanel>
</UserControl>
