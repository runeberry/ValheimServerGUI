<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compact density pass (§ V3 styling). Merged AFTER FluentTheme so these win. Restores the
         WinForms 2.x information-dense feel: ~12px base font, ~23px control heights, tight margins, and
         crisp 2px corners — implemented purely as theme-resource + selector overrides so the whole tree
         (including the separate dialog Windows) inherits it and it still scales cleanly across DPIs. -->

    <Styles.Resources>
        <!-- Global Fluent knobs many control themes read from. -->
        <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
        <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
        <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
        <Thickness x:Key="TabItemHeaderMargin">10,4</Thickness>
        <Thickness x:Key="ComboBoxDropdownContentMargin">0,2</Thickness>
        <x:Double x:Key="ComboBoxItemThemeMinHeight">26</x:Double>
        <x:Double x:Key="MenuFlyoutThemeMinHeight">26</x:Double>
    </Styles.Resources>

    <!-- Base font: Segoe UI on Windows, the bundled Inter elsewhere. Inherits to every descendant.
         Base surface is the layered app background (no pure black); menu/footer paint darker themselves. -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI, Inter" />
        <Setter Property="FontSize" Value="12" />
        <!-- App background blends with the menu/footer (darkest); only tabs + content stand out. -->
        <Setter Property="Background" Value="{DynamicResource LayerDarkest}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Padding" Value="10,2" />
    </Style>

    <!-- Icon-only 16x16 button: no min width, fixed to the standard input height so a row of
         [text box | icon button] stays a uniform height and the two align. Reads as a slim floating icon —
         no background or border at rest OR on hover/press, just a hand cursor. Fluent paints the button
         chrome on PART_ContentPresenter per state, so each state is forced transparent here (app Style beats
         the ControlTheme's state styles). -->
    <Style Selector="Button.icon">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="23" />
        <!-- The spinner theme binds the inner box's padding to NumericUpDown.Padding, so set it here to
             match the text inputs (6px left) — otherwise the number is pressed against the left edge. -->
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- CheckBox / RadioButton are fully retemplated (12px box/circle, tight margins) in
         Styles/CheckBox.axaml and Styles/RadioButton.axaml — a Style pass can't shrink the box because
         Fluent hard-codes the part sizes as local values, so we own the template instead. -->

    <!-- TabItem look lives in Styles/TabStyles.axaml (the custom bordered tab theme). -->

    <Style Selector="Menu">
        <Setter Property="MinHeight" Value="0" />
        <!-- Menu bar is the darkest layer. -->
        <Setter Property="Background" Value="{DynamicResource LayerDarkest}" />
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Padding" Value="8,1.5" />
    </Style>
</Styles>
