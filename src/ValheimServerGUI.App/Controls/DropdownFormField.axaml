<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             x:Class="ValheimServerGUI.App.Controls.DropdownFormField"
             x:Name="Root" x:CompileBindings="False">
    <c:FormRow Header="{Binding #Root.LabelText}" HelpText="{Binding #Root.HelpText}">
        <ComboBox HorizontalAlignment="Stretch"
                  ItemsSource="{Binding #Root.ItemsSource}"
                  SelectedItem="{Binding #Root.Value, Mode=TwoWay}" />
    </c:FormRow>
</UserControl>
