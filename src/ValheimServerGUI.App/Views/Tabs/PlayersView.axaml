<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.PlayersView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Button Content="View Player Details…" Command="{Binding Players.ViewDetailsCommand}" />
                <Button Content="Add by ID…" Command="{Binding Players.AddByIdCommand}" />
            </StackPanel>
            <c:HyperlinkLabel Grid.Column="2" Text="Character names wrong? Click here."
                              Command="{Binding CharacterNamesHelpCommand}" VerticalAlignment="Center" />
        </Grid>

        <c:DataListView ItemsSource="{Binding Players.Players}"
                        SelectedItem="{Binding Players.SelectedPlayer}"
                        RowInvokeCommand="{Binding Players.ViewDetailsCommand}">
            <c:DataListView.RowContextMenu>
                <ContextMenu>
                    <MenuItem Header="View Player Details…" Command="{Binding Players.ViewDetailsCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Players.AdminToggleLabel}" Command="{Binding Players.ToggleAdminCommand}" />
                    <MenuItem Header="{Binding Players.BanToggleLabel}" Command="{Binding Players.ToggleBanCommand}" />
                    <MenuItem Header="{Binding Players.PermitToggleLabel}" Command="{Binding Players.TogglePermitCommand}" />
                    <Separator />
                    <MenuItem Header="Add player by ID…" Command="{Binding Players.AddByIdCommand}" />
                    <MenuItem Header="Remove player" Command="{Binding Players.RemoveCommand}" />
                </ContextMenu>
            </c:DataListView.RowContextMenu>
            <c:DataListView.Styles>
                <Style Selector="DataGridRow" x:DataType="vm:PlayerRowViewModel">
                    <Setter Property="Opacity"
                            Value="{Binding IsOffline, Converter={x:Static conv:OfflineOpacityConverter.Instance}}" />
                </Style>
                <!-- A selected row is shown at full strength even when offline (the dim is only a
                     background cue, so the selection stays legible at the standard font colour). -->
                <Style Selector="DataGridRow:selected" x:DataType="vm:PlayerRowViewModel">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </c:DataListView.Styles>
            <c:DataListView.Columns>
                <!-- Platform icon is a prefix of the name (its own column was collapsed here); the column
                     still sorts by the plain DisplayName so the icon doesn't affect ordering. -->
                <DataGridTemplateColumn Header="Player (Character)" Width="*" SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Image Source="{Binding PlatformIcon}" Width="16" Height="16"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Access-list membership as a single role (profile-scoped), highest priority first:
                     Admin > Permitted > Banned. Blank when the player is in none of the lists. Kept the same
                     fixed width as Status (the column to its right) so the two read as a matched pair. -->
                <DataGridTemplateColumn Header="Role" Width="100" SortMemberPath="RoleText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Image Width="16" Height="16" VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       Source="{Binding RoleIcon}" />
                                <TextBlock Text="{Binding RoleText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Status text prefixed with a glyph representing the status. Width matches Role (its left neighbour). -->
                <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Image Width="16" Height="16" VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       Source="{Binding Status, Converter={x:Static conv:PlayerStatusToIconConverter.Instance}}" />
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Since" Width="Auto" SortMemberPath="SinceText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <TextBlock Text="{Binding SinceText}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </c:DataListView.Columns>
            <c:DataListView.FooterRight>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <c:IconButton IconName="Add_16x" ToolTip.Tip="Add player by ID"
                                  Command="{Binding Players.AddByIdCommand}" />
                    <c:IconButton IconName="Cancel_16x" ToolTip.Tip="Remove player"
                                  Command="{Binding Players.RemoveCommand}" />
                </StackPanel>
            </c:DataListView.FooterRight>
        </c:DataListView>
    </DockPanel>
</UserControl>
