<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ValheimServerGUI.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the OS theme variant; the App applies the user's Light/Dark/System
         preference at startup via RequestedThemeVariant (see App.axaml.cs). -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- App-level styling (Styles/): the palette + retemplated STOCK controls, each named after
                     the control it themes. Merged into Application.Resources so they override Fluent. -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/Palette.axaml" />
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/CheckBox.axaml" />
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/RadioButton.axaml" />
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/NumericUpDown.axaml" />
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/TabStyles.axaml" />

                <!-- Custom-control themes (Controls/): each is the ControlTheme for the same-named control. -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/FormRow.axaml" />
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/GroupBox.axaml" />
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/HelpLabel.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://ValheimServerGUI.App/Styles/AppStyles.axaml" />
        <!-- Compact density pass — merged last so it overrides Fluent's touch-sized defaults. -->
        <StyleInclude Source="avares://ValheimServerGUI.App/Styles/Compact.axaml" />
    </Application.Styles>
</Application>
