<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ValheimServerGUI.App.Views.Dialogs.TextPromptWindow"
        SizeToContent="Height" Width="420"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" KeyDown="OnInputKeyDown" />
        <TextBlock x:Name="ErrorText" Foreground="#E53935" IsVisible="False" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
