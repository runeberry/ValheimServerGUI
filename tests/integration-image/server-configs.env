# Pins for the bepinex server configuration, shared by the container image (scripts/integration.sh passes each
# line as a --build-arg) and the Windows VM image (scripts/integration-windows.sh passes them to bake-server.ps1).
# Plain KEY=value lines, sourceable by bash. Third-party mods are downloaded at build time, never stored here.

# The mod loader (Thunderstore denikson/BepInExPack_Valheim). Its archive holds the server-folder files under
# BepInExPack_Valheim/.
BEPINEX_PACK_URL=https://thunderstore.io/package/download/denikson/BepInExPack_Valheim/5.4.2351/
BEPINEX_PACK_SHA256=bce631497976a93977ceb08e166712e6c31d15244956f89f17df092a9b62e29f

# The plugins, each "<folder under BepInEx/plugins>|<Thunderstore download URL>|<sha256>", separated by spaces. Each
# archive has its DLL at the root.
#   JereKuusela/Server_devcommands 1.115.0 (Unlicense): a popular server-side plugin.
#   Smoothbrain/Network 1.0.2: uncaps network send/receive limits.
PLUGINS="JereKuusela-Server_devcommands|https://thunderstore.io/package/download/JereKuusela/Server_devcommands/1.115.0/|b2752c18342bc9cabf4734e3480cd2cc4aa9faa8955ba503d4f7cefcfa3e4b33 Smoothbrain-Network|https://thunderstore.io/package/download/Smoothbrain/Network/1.0.2/|1c3716cb13e79208a3fde689df2bfc56156bd36ea3a6be21d90f518dff620f92"

# What the BepInEx chainloader logs for each plugin, "Loading [<Name> <Version>]", from the plugin's own
# [BepInPlugin] attribute (Server Devcommands says 1.115, not the package's 1.115.0). Separated by ';', in any order.
# Update it with PLUGINS.
EXPECTED_PLUGINS="Server Devcommands 1.115;Network 1.0.2"
