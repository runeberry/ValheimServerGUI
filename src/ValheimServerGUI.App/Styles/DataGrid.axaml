<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Density for the shared DataListView grid, over the Caprilyn DataGrid theme. The header (28px) and rows (20px) have
         fixed heights (set on the DataGrid in DataListView.cs) with content vertically centred, so cells and headers take a
         single 6px horizontal inset and no vertical padding: a 16px icon rests in a row with room to spare. -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="6,0" />
    </Style>
</Styles>
