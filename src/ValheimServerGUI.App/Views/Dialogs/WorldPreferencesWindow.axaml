<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ValheimServerGUI.Localization"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.WorldPreferencesWindow"
        x:DataType="vm:WorldPreferencesViewModel"
        Title="{Binding WorldName, StringFormat={x:Static loc:Strings.WorldPreferences_Title}}"
        SizeToContent="Height" Width="460" MinWidth="400"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="10">
        <c:DropdownFormField LabelText="{x:Static loc:Strings.WorldPreferences_Preset_Label}" Width="240" HorizontalAlignment="Left"
                             HelpText="{x:Static loc:Strings.WorldPreferences_Preset_Help}"
                             ItemsSource="{Binding Presets}" Value="{Binding SelectedPresetDisplay}" />

        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.WorldPreferences_WikiPrefix}"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <c:HyperlinkLabel Text="{x:Static loc:Strings.WorldPreferences_WikiLink}" Command="{Binding OpenWorldModifiersWikiCommand}" />
        </StackPanel>

        <TextBlock Text="{x:Static loc:Strings.WorldPreferences_Modifiers_Header}" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Modifiers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModifierRow">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,2,0,2">
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" MinWidth="110" />
                        <c:DropdownFormField Width="160" ItemsSource="{Binding Options}" Value="{Binding Selected}" />
                        <c:HelpLabel HelpText="{Binding HelpText}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="2" Margin="12,0,0,0">
            <TextBlock Text="{x:Static loc:Strings.WorldPreferences_NotWorking}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <c:HyperlinkLabel Text="{x:Static loc:Strings.WorldPreferences_NotWorkingLink}" Command="{Binding OpenWorldModifiersHelpCommand}" />
        </StackPanel>

        <TextBlock Text="{x:Static loc:Strings.WorldPreferences_Keys_Header}" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Keys}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorldKeyToggle">
                    <c:CheckBoxFormField LabelText="{Binding DisplayName}" HelpText="{Binding HelpText}"
                                         Value="{Binding IsSet}" Margin="12,0,0,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{x:Static loc:Strings.Common_RestoreDefaults}" Click="OnRestoreDefaults" />
            <Button Content="{x:Static loc:Strings.Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="{x:Static loc:Strings.Common_Cancel}" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
