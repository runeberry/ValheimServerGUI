<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:ValheimServerGUI.App.Controls">

    <!-- The shared data table: an inner DataGrid (PART_Grid) with an optional compact footer bar below it,
         wrapped in a 1px frame that matches the other controls' borders. The footer hosts action icon
         buttons anchored left and/or right and only appears when a slot is filled (HasFooter); its
         horizontal inset (6px) and density match the (halved) dark column header. -->
    <ControlTheme x:Key="{x:Type c:DataListView}" TargetType="c:DataListView">
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <!-- Footer: same dark bar and height as the header (HeaderFooterHeight), content centred. -->
                        <Border DockPanel.Dock="Bottom" IsVisible="{TemplateBinding HasFooter}"
                                Background="{DynamicResource LayerDarkest}"
                                Height="{x:Static c:DataListView.HeaderFooterHeight}" Padding="6,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <ContentControl Grid.Column="0" Content="{TemplateBinding FooterLeft}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <ContentControl Grid.Column="2" Content="{TemplateBinding FooterRight}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <DataGrid Name="PART_Grid" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
