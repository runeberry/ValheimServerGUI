<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             x:Class="ValheimServerGUI.App.Controls.FilenameFormField"
             x:Name="Root" x:CompileBindings="False">
    <c:FormRow Header="{Binding #Root.LabelText}" HelpText="{Binding #Root.HelpText}">
        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" VerticalAlignment="Center" Text="{Binding #Root.Value, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="…" Margin="4,0,0,0"
                    ToolTip.Tip="Browse…" Click="Browse" />
            <ContentControl Grid.Column="2" Content="{Binding #Root.TrailingContent}"
                            IsVisible="{Binding #Root.TrailingContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
    </c:FormRow>
</UserControl>
