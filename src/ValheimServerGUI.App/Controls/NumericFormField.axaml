<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             x:Class="ValheimServerGUI.App.Controls.NumericFormField"
             x:Name="Root" x:CompileBindings="False">
    <c:FormRow Header="{Binding #Root.LabelText}" HelpText="{Binding #Root.HelpText}">
        <NumericUpDown Value="{Binding #Root.Value, Mode=TwoWay}"
                       Minimum="{Binding #Root.Minimum}"
                       Maximum="{Binding #Root.Maximum}"
                       FormatString="0" />
    </c:FormRow>
</UserControl>
