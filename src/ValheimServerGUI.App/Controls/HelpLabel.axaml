<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:ValheimServerGUI.App.Controls">

    <!-- The bold accent "?" help glyph. Its tooltip is HelpText; the control's visibility (collapse when
         HelpText is empty) is driven from HelpLabel.cs. -->
    <ControlTheme x:Key="{x:Type c:HelpLabel}" TargetType="c:HelpLabel">
        <!-- The 'help' cursor (arrow + ?) is the semantically correct hover for a help hint. -->
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Help stays readable on a disabled field: ShowOnDisabled opens the tooltip even when an
                     ancestor (the field) is disabled, and the fixed Foreground keeps the glyph from greying. -->
                <TextBlock Text="?"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource HelpGlyphBrush}"
                           ToolTip.Tip="{TemplateBinding HelpText}"
                           ToolTip.ShowOnDisabled="True" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
