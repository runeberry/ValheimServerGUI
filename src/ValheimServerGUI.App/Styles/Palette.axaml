<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Layered surface palette (VS Code-inspired), theme-variant aware. No pure black anywhere.
         Three depths, darkest to lightest:
           LayerDarkest  — menu bar + footer
           LayerBase     — app/window background + inactive tabs
           LayerContent  — active tab + tab content (the "raised" surface)
         AppBorderBrush is the hairline used for tab/frame borders. -->
    <!-- The "?" help glyph shares the controls' accent (checkbox/radio/focus) instead of a hardcoded
         blue. Reusable token; tracks SystemAccentColor so it always matches the control highlight. -->
    <SolidColorBrush x:Key="HelpGlyphBrush" Color="{DynamicResource SystemAccentColor}" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="LayerDarkest" Color="#1E1E1E" />
            <SolidColorBrush x:Key="LayerBase" Color="#252526" />
            <SolidColorBrush x:Key="LayerContent" Color="#2D2D30" />
            <SolidColorBrush x:Key="LayerBaseHover" Color="#323233" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#3F3F46" />
            <!-- High-contrast button outline (overrides Fluent's faint default) — kept for rest/hover/pressed
                 so the border never fades; disabled stays Fluent's muted brush. -->
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#9A9A9A" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#9A9A9A" />
            <!-- Disabled buttons keep the high-contrast outline too (was previously left to Fluent's muted brush). -->
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#9A9A9A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LayerDarkest" Color="#D4D4D4" />
            <SolidColorBrush x:Key="LayerBase" Color="#ECECEC" />
            <SolidColorBrush x:Key="LayerContent" Color="#FBFBFB" />
            <SolidColorBrush x:Key="LayerBaseHover" Color="#E0E0E0" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#BFBFBF" />
            <!-- High-contrast button outline: a proper dark edge in light theme (Fluent's default nearly
                 disappears). Rest/hover/pressed all use it; disabled stays Fluent's muted brush. -->
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#6B6B6B" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#6B6B6B" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#6B6B6B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
