<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.AddPlayerWindow"
        x:DataType="vm:AddPlayerViewModel"
        Title="Add Player"
        SizeToContent="Height" Width="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="12">
        <c:DropdownFormField LabelText="Platform"
                             ItemsSource="{Binding Platforms}"
                             Value="{Binding SelectedPlatform}" />

        <c:TextFormField LabelText="Platform ID"
                         Watermark="e.g. 76561198000000000"
                         Value="{Binding PlayerId}" />

        <c:TextFormField LabelText="Player Name" MaxLength="64"
                         Value="{Binding PlayerName}" />

        <c:DropdownFormField LabelText="Role" IsVisible="{Binding ShowRole}"
                             ItemsSource="{Binding Roles}"
                             Value="{Binding SelectedRole}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Add Player" MinWidth="80" IsDefault="True" IsEnabled="{Binding CanSubmit}" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
