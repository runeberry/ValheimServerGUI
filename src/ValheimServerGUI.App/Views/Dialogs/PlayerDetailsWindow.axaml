<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:conv="using:ValheimServerGUI.App.Converters"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.PlayerDetailsWindow"
        x:DataType="vm:PlayerDetailsViewModel"
        Title="Player Info"
        SizeToContent="Height" Width="460" MinWidth="420"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="8">
        <!-- Every row carries a trailing icon-button slot (a real button, or an inactive placeholder) so
             the rows are evenly spaced and the help glyphs line up down the column. -->
        <StackPanel Spacing="2">
            <c:LabelField LabelText="Player Name:" Value="{Binding DisplayNameOrUnknown}"
                          HelpText="The player's Steam/Xbox username. This will be determined automatically, but in case it doesn't work, you may edit the player's name manually.">
                <c:LabelField.TrailingContent>
                    <c:EditButton x:Name="EditNameButton" ToolTip.Tip="Edit player name" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="Platform:" Value="{Binding Platform}">
                <c:LabelField.TrailingContent>
                    <c:IconButton IsEnabled="False" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="Platform ID:" Value="{Binding PlayerId}"
                          ValueIcon="{Binding Platform, Converter={x:Static conv:PlatformToIconConverter.Instance}}"
                          HelpText="The ID associated with the player's Steam or Xbox account. You can use this ID to allow or ban players, or add players as admins.">
                <c:LabelField.TrailingContent>
                    <c:CopyButton Text="{Binding PlayerId}" ToolTip.Tip="Copy Steam ID to clipboard" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="ZDO ID:" Value="{Binding ZdoId}"
                          HelpText="The player's object ID in game. This changes with each game session.">
                <c:LabelField.TrailingContent>
                    <c:IconButton IsEnabled="False" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="Latest Character:" Value="{Binding LatestCharacter}"
                          HelpText="The character that this player is currently playing, or if they're offline, the last character they logged in as.">
                <c:LabelField.TrailingContent>
                    <c:IconButton IsEnabled="False" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="Online Status:" Value="{Binding Status}"
                          ValueIcon="{Binding StatusValue, Converter={x:Static conv:PlayerStatusToIconConverter.Instance}}"
                          HelpText="Possible statuses are: Online, Offline, Joining, or Leaving">
                <c:LabelField.TrailingContent>
                    <c:IconButton IsEnabled="False" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="Status Changed:" Value="{Binding StatusChanged}">
                <c:LabelField.TrailingContent>
                    <c:IconButton IsEnabled="False" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
        </StackPanel>

        <StackPanel Spacing="4" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Known Characters" FontWeight="SemiBold" VerticalAlignment="Center" />
                <c:HelpLabel HelpText="The Valheim character names that this player is known by. Names are automatically added to this list when a player joins the server, but you may modify them manually.&#10;&#10;If a name appears with a (!), it means that name may not be matched to the correct player (due to a Valheim server limitation). You may remove this name if it's incorrect, or select the name and click Confirm to remove the warning." />
            </StackPanel>
            <c:DataListView x:Name="CharactersListView" Height="140" ItemsSource="{Binding Characters}"
                            SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}">
                <c:DataListView.RowContextMenu>
                    <ContextMenu>
                        <!-- Rename opens a window-owned prompt, so its command is wired in code-behind. -->
                        <MenuItem x:Name="RenameCharacterMenuItem" Header="Rename character" />
                        <MenuItem Header="Remove character name" Command="{Binding RemoveCharacterCommand}" />
                    </ContextMenu>
                </c:DataListView.RowContextMenu>
                <c:DataListView.Columns>
                    <!-- Items are plain strings; a reflection binding resolves the row item itself (the
                         inner grid isn't in this window's compiled-binding DataType scope). -->
                    <DataGridTextColumn Header="Name" Binding="{ReflectionBinding}" Width="*" CanUserSort="False" />
                </c:DataListView.Columns>
                <c:DataListView.FooterLeft>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:IconButton x:Name="AddCharacterButton" IconName="Add_16x" ToolTip.Tip="Add" />
                        <c:IconButton x:Name="EditCharacterButton" IconName="Edit_16x" ToolTip.Tip="Rename" />
                        <c:IconButton IconName="Cancel_16x" ToolTip.Tip="Remove"
                                      Command="{Binding RemoveCharacterCommand}" />
                    </StackPanel>
                </c:DataListView.FooterLeft>
                <c:DataListView.FooterRight>
                    <c:RefreshButton ToolTip.Tip="Refresh player data" Command="{Binding RefreshCommand}" />
                </c:DataListView.FooterRight>
            </c:DataListView>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
