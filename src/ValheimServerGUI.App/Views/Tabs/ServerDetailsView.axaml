<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.ServerDetailsView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <StackPanel Margin="8" Spacing="4">
            <c:GroupBox Header="Connection Details">
                <StackPanel Spacing="2">
                    <c:LabelField LabelText="External IP Address:" Value="{Binding Details.ExternalIp}"
                                  HelpText="This is the address that players from outside your home network will use to connect to your server. Give this address to your friends for standard online play.">
                        <c:LabelField.TrailingContent>
                            <c:CopyButton Text="{Binding Details.ExternalIp}" ToolTip.Tip="Copy external IP address to clipboard" />
                        </c:LabelField.TrailingContent>
                    </c:LabelField>

                    <c:LabelField LabelText="Internal IP Address:" Value="{Binding Details.InternalIp}"
                                  HelpText="This is the address that players on your home network (connected to your router) can use to join your server. Give this address to your friends for LAN setups, or use it yourself if you're hosting your server on another machine on your home network (different from the one you're playing on).">
                        <c:LabelField.TrailingContent>
                            <c:CopyButton Text="{Binding Details.InternalIp}" ToolTip.Tip="Copy internal IP address to clipboard" />
                        </c:LabelField.TrailingContent>
                    </c:LabelField>

                    <c:LabelField LabelText="Local IP Address:" Value="{Binding Details.LocalIp}"
                                  HelpText="Use this IP address to connect to your server if you're playing on the host machine. This will give you the fastest possible connection! (i.e. &quot;the host advantage&quot;)&#10;&#10;TIP: You can also connect to &quot;localhost&quot;, which is a little easier than typing &quot;127.0.0.1&quot;">
                        <c:LabelField.TrailingContent>
                            <c:CopyButton Text="{Binding Details.LocalIp}" ToolTip.Tip="Copy local IP address to clipboard" />
                        </c:LabelField.TrailingContent>
                    </c:LabelField>

                    <c:LabelField LabelText="Invite Code:" Value="{Binding Details.InviteCode}"
                                  HelpText="Invite codes are only available when Crossplay is enabled and change each time the server is restarted. Players on any platform can connect to your server with an invite code instead of an IP address.">
                        <c:LabelField.TrailingContent>
                            <!-- Keep the copy button's slot even when there's no invite code to copy, so the
                                 help glyph doesn't shift between rows (hidden-but-reserved, not collapsed). -->
                            <c:CopyButton Text="{Binding Details.InviteCode}" ToolTip.Tip="Copy invite code to clipboard"
                                          Opacity="{Binding Details.InviteCodeCopyable, Converter={x:Static conv:BooleanToOpacityConverter.Instance}}"
                                          IsHitTestVisible="{Binding Details.InviteCodeCopyable}" />
                        </c:LabelField.TrailingContent>
                    </c:LabelField>

                    <TextBlock Margin="0,4,0,0" FontStyle="Italic"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="Trouble connecting? See Help &gt; Port Forwarding." />
                </StackPanel>
            </c:GroupBox>

            <c:GroupBox Header="Statistics">
                <StackPanel Spacing="2">
                    <c:LabelField LabelText="Server Uptime:" Value="{Binding Details.Uptime}" />
                    <c:LabelField LabelText="Last World Save:" Value="{Binding Details.LastWorldSave}" />
                    <c:LabelField LabelText="Avg. World Save:" Value="{Binding Details.AverageWorldSave}"
                                  HelpText="The average amount of time it has taken to save your game world, over the past 10 saves." />
                </StackPanel>
            </c:GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
