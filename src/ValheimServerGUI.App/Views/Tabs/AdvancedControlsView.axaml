<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.AdvancedControlsView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <Grid Margin="8" ColumnDefinitions="*,8,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <c:GroupBox Header="Directory Overrides (for just this Profile)">
                    <StackPanel Spacing="2">
                        <c:FilenameFormField LabelText="Valheim Dedicated Server .exe" SelectMode="File"
                                             HelpText="Leave blank to use the default from Preferences."
                                             Value="{Binding Form.ServerExePath}" IsEnabled="{Binding AllowServerChanges}">
                            <c:FilenameFormField.TrailingContent>
                                <c:OpenButton Margin="4,0,0,0" ToolTip.Tip="Open server folder"
                                              Command="{Binding OpenServerExeFolderCommand}" />
                            </c:FilenameFormField.TrailingContent>
                        </c:FilenameFormField>
                        <c:FilenameFormField LabelText="Valheim Save Data Folder" SelectMode="Directory"
                                             HelpText="Leave blank to use the default from Preferences."
                                             Value="{Binding Form.SaveDataFolderPath}" IsEnabled="{Binding AllowServerChanges}">
                            <c:FilenameFormField.TrailingContent>
                                <c:OpenButton Margin="4,0,0,0" ToolTip.Tip="Open save folder"
                                              Command="{Binding OpenSaveFolderCommand}" />
                            </c:FilenameFormField.TrailingContent>
                        </c:FilenameFormField>
                    </StackPanel>
                </c:GroupBox>

                <c:GroupBox Header="Other Settings">
                    <StackPanel Spacing="4">
                        <c:CheckBoxFormField LabelText="Start this server when ValheimServerGUI starts"
                                             Value="{Binding Form.AutoStart}" IsEnabled="{Binding AllowServerChanges}" />
                        <c:CheckBoxFormField LabelText="Write server logs to file"
                                             Value="{Binding Form.WriteServerLogsToFile}" IsEnabled="{Binding AllowServerChanges}" />
                        <c:TextFormField LabelText="Additional Command Line Args"
                                         HelpText="Extra arguments passed to the server (the -logFile argument is not allowed)."
                                         Value="{Binding Form.AdditionalArgs}" MaxLength="32767"
                                         IsEnabled="{Binding AllowServerChanges}" />
                    </StackPanel>
                </c:GroupBox>
            </StackPanel>

            <c:GroupBox Grid.Column="2" Header="Saving &amp; Backups" VerticalAlignment="Top">
                <StackPanel Spacing="2" Width="150">
                    <c:NumericFormField LabelText="Save Interval" Value="{Binding Form.SaveInterval}"
                                        Minimum="60" Maximum="86400" IsEnabled="{Binding AllowServerChanges}"
                                        HelpText="How often the world is auto-saved, in seconds (60–86400)." />
                    <c:NumericFormField LabelText="Backups" Value="{Binding Form.BackupCount}"
                                        Minimum="1" Maximum="1000" IsEnabled="{Binding AllowServerChanges}"
                                        HelpText="Number of world backups to retain (1–1000)." />
                    <c:NumericFormField LabelText="Short Backup" Value="{Binding Form.BackupIntervalShort}"
                                        Minimum="300" Maximum="2592000" IsEnabled="{Binding AllowServerChanges}"
                                        HelpText="Short backup interval, in seconds (300–2592000)." />
                    <c:NumericFormField LabelText="Long Backup" Value="{Binding Form.BackupIntervalLong}"
                                        Minimum="300" Maximum="2592000" IsEnabled="{Binding AllowServerChanges}"
                                        HelpText="Long backup interval, in seconds (300–2592000)." />
                </StackPanel>
            </c:GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
