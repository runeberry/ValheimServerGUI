<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compact density pass (§ V3 styling). Merged AFTER FluentTheme so these win. Restores the
         WinForms 2.x information-dense feel: ~12px base font, ~23px control heights, tight margins, and
         crisp 2px corners — implemented purely as theme-resource + selector overrides so the whole tree
         (including the separate dialog Windows) inherits it and it still scales cleanly across DPIs. -->

    <Styles.Resources>
        <!-- Global Fluent knobs many control themes read from. -->
        <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
        <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
        <x:Double x:Key="TabItemHeaderFontSize">13</x:Double>
        <Thickness x:Key="TabItemHeaderMargin">10,4</Thickness>
        <Thickness x:Key="ComboBoxDropdownContentMargin">0,2</Thickness>
        <x:Double x:Key="ComboBoxItemThemeMinHeight">26</x:Double>
        <x:Double x:Key="MenuFlyoutThemeMinHeight">26</x:Double>
    </Styles.Resources>

    <!-- Base font: Segoe UI on Windows, the bundled Inter elsewhere. Inherits to every descendant.
         Base surface is the layered app background (no pure black); menu/footer paint darker themselves. -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI, Inter" />
        <Setter Property="FontSize" Value="12" />
        <!-- App background blends with the menu/footer (darkest); only tabs + content stand out. -->
        <Setter Property="Background" Value="{DynamicResource LayerDarkest}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Padding" Value="10,2" />
    </Style>

    <!-- Icon-only 16x16 button: no min width, fixed to the standard input height so a row of
         [text box | icon button] stays a uniform height and the two align. -->
    <Style Selector="Button.icon">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="23" />
        <!-- The spinner theme binds the inner box's padding to NumericUpDown.Padding, so set it here to
             match the text inputs (6px left) — otherwise the number is pressed against the left edge. -->
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="6,0,0,0" />
    </Style>
    <!-- Shrink the check box (Fluent's is a 20px square in a 32px row) to a 12px box. Resizes the existing
         template parts so all Fluent states/animations are preserved. Part names verified against Avalonia 12. -->
    <Style Selector="CheckBox /template/ Border#PART_Border">
        <Setter Property="MinHeight" Value="16" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinWidth" Value="12" />
    </Style>

    <!-- Shrink the radio button's circle (20px -> 12px) and its centre dot, and the row height. -->
    <Style Selector="RadioButton /template/ Border#RootBorder">
        <Setter Property="MinHeight" Value="16" />
    </Style>
    <Style Selector="RadioButton /template/ Ellipse#OuterEllipse, RadioButton /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="RadioButton /template/ Ellipse#CheckGlyph">
        <Setter Property="Width" Value="5" />
        <Setter Property="Height" Value="5" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="6,0,0,0" />
    </Style>

    <!-- TabItem look lives in Controls/TabStyles.axaml (the custom bordered tab theme). -->

    <Style Selector="Menu">
        <Setter Property="MinHeight" Value="0" />
        <!-- Menu bar is the darkest layer. -->
        <Setter Property="Background" Value="{DynamicResource LayerDarkest}" />
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Padding" Value="8,3" />
    </Style>
</Styles>
