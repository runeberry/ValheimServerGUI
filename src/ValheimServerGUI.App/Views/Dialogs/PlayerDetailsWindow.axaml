<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.PlayerDetailsWindow"
        x:DataType="vm:PlayerDetailsViewModel"
        Title="Player Details"
        SizeToContent="Height" Width="460" MinWidth="420"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="8">
        <Grid ColumnDefinitions="130,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform:" />
            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Platform}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Player ID:" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlayerId}" />
            <Button Grid.Row="1" Grid.Column="2" Classes="icon" ToolTip.Tip="Copy" Click="CopyPlayerId" Margin="4,0,0,0">
                <Image Source="{c:Icon Copy_16x}" Width="16" Height="16" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Button>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="ZDO ID:" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ZdoId}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Latest Character:" />
            <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LatestCharacter}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" />
            <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Display Name:" VerticalAlignment="Center" MinWidth="122" />
            <TextBox Text="{Binding DisplayName}" MaxLength="64" MinWidth="220" />
        </StackPanel>

        <TextBlock Text="Known Characters" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" Height="120" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Add" Click="AddCharacter" />
            <Button Content="Rename" Click="RenameCharacter" />
            <Button Content="Remove" Command="{Binding RemoveCharacterCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
