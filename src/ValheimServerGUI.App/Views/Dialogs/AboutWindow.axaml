<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="About"
        SizeToContent="WidthAndHeight" MinWidth="360"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="24" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Classes="link" Content="GitHub" Command="{Binding OpenGitHubCommand}" />
            <Button Classes="link" Content="Discord" Command="{Binding OpenDiscordCommand}" />
            <Button Classes="link" Content="Donate" Command="{Binding OpenDonateCommand}" />
        </StackPanel>
        <Button Content="Close" MinWidth="80" HorizontalAlignment="Center" Margin="0,12,0,0"
                IsDefault="True" IsCancel="True" Click="OnClose" />
    </StackPanel>
</Window>
