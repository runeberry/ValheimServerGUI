<Project>

  <!--
    Redirect ALL build output (bin + obj, every project) to a per-user directory under $HOME
    (the SDK's artifacts-output layout) instead of the working tree.

    This lets several users share one checkout through a group: MSBuild's up-to-date marker
    needs file *ownership* to set a timestamp (group write is not enough), so in-tree obj/
    output from one user makes another user's build fail with MSB3374 ("Access to the path
    ...Up2Date is denied"). It also keeps the repo tree free of build output.

    Windows does not set HOME by default (Git for Windows often does), so fall back to USERPROFILE
    there; without it the path would resolve to the root of the drive.
  -->
  <PropertyGroup>
    <VsgUserHome>$(HOME)</VsgUserHome>
    <VsgUserHome Condition="'$(VsgUserHome)' == ''">$(USERPROFILE)</VsgUserHome>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(VsgUserHome)/.cache/valheim-server-gui/artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
