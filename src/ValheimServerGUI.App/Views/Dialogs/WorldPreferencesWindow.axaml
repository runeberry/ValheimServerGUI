<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.WorldPreferencesWindow"
        x:DataType="vm:WorldPreferencesViewModel"
        Title="World Preferences"
        SizeToContent="Height" Width="460" MinWidth="400"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="{Binding WorldName, StringFormat='World: {0}'}" FontWeight="SemiBold" />

        <c:DropdownFormField LabelText="Preset" Width="240" HorizontalAlignment="Left"
                             HelpText="Presets are quick sets of options to help you get a server up and running quickly.&#10;&#10;If you select a preset and change any individual settings, then the preset will be deselected."
                             ItemsSource="{Binding Presets}" Value="{Binding SelectedPresetDisplay}" />

        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Read more about world modifiers on the"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <c:HyperlinkLabel Text="Valheim Wiki." Command="{Binding OpenWorldModifiersWikiCommand}" />
        </StackPanel>

        <TextBlock Text="Modifiers" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Modifiers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModifierRow">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,2,0,2">
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" MinWidth="110" />
                        <c:DropdownFormField Width="160" ItemsSource="{Binding Options}" Value="{Binding Selected}" />
                        <c:HelpLabel HelpText="{Binding HelpText}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="2" Margin="12,0,0,0">
            <TextBlock Text="Modifiers not working like you expected? You may already have modifiers set in-game."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <c:HyperlinkLabel Text="Read more here." Command="{Binding OpenWorldModifiersHelpCommand}" />
        </StackPanel>

        <TextBlock Text="Keys" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Keys}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorldKeyToggle">
                    <c:CheckBoxFormField LabelText="{Binding DisplayName}" HelpText="{Binding HelpText}"
                                         Value="{Binding IsSet}" Margin="12,0,0,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Restore Defaults" Click="OnRestoreDefaults" />
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
