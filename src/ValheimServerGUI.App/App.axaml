<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ValheimServerGUI.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the OS theme variant; the App applies the user's Light/Dark/System
         preference at startup via RequestedThemeVariant (see App.axaml.cs). -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Layered surface palette (theme-variant aware; no pure black). -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/Palette.axaml" />
                <!-- Shared form-row template + input styling (§11.2). -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/FormControls.axaml" />
                <!-- Etched group-box control theme. -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/GroupBox.axaml" />
                <!-- Shared "?" help-glyph control theme. -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/HelpLabel.axaml" />
                <!-- Compact retemplated CheckBox / RadioButton (12px box, tight margins). Merged into
                     Application.Resources so they override Fluent's built-in themes. -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/CheckBox.axaml" />
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/RadioButton.axaml" />
                <!-- Compact vertically-stacked NumericUpDown spinner (ported from mochi-paint). -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/NumericSpinner.axaml" />
                <!-- WinForms-style bordered tab strip. -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Styles/TabStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://ValheimServerGUI.App/Styles/AppStyles.axaml" />
        <!-- Compact density pass — merged last so it overrides Fluent's touch-sized defaults. -->
        <StyleInclude Source="avares://ValheimServerGUI.App/Styles/Compact.axaml" />
    </Application.Styles>
</Application>
