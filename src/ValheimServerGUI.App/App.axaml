<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ValheimServerGUI.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the OS theme variant; the App applies the user's Light/Dark/System
         preference at startup via RequestedThemeVariant (see App.axaml.cs). -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared form-row template + input styling (§11.2). -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/FormControls.axaml" />
                <!-- Etched group-box control theme. -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/GroupBox.axaml" />
                <!-- Compact vertically-stacked NumericUpDown spinner (ported from mochi-paint). -->
                <ResourceInclude Source="avares://ValheimServerGUI.App/Controls/NumericSpinner.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://ValheimServerGUI.App/Controls/AppStyles.axaml" />
        <!-- Compact density pass — merged last so it overrides Fluent's touch-sized defaults. -->
        <StyleInclude Source="avares://ValheimServerGUI.App/Styles/Compact.axaml" />
    </Application.Styles>
</Application>
