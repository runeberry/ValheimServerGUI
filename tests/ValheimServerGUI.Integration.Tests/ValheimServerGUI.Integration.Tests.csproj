<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live (tier-4) integration tests against a REAL Valheim dedicated server (docs/V3_TARGET_STATE.md
    §13, matrix E9). The project always builds with the solution, but it is only a TEST project when asked
    for explicitly: `dotnet test -p:Integration=true` runs the complete suite (unit + integration), while a
    plain `dotnet test` runs unit tests only. scripts/integration.sh is the usual way to pass the flag (it
    loads the machine config). Once asked for, a misconfiguration is a failure, never a skip: see
    IntegrationConfig. See CLAUDE.local.md "Integration testing".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestProject Condition="'$(Integration)' == 'true'">true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ValheimServerGUI.Core\ValheimServerGUI.Core.csproj" />
  </ItemGroup>

</Project>
