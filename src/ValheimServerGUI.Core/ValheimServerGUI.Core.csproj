<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      The real application version lives here, on the Core assembly, because AssemblyHelper reads the
      EXECUTING assembly (Core) for the update-check comparison and the About dialog. The App version is
      cosmetic. SourceRevisionId appends a "+build<date>" suffix to the informational version (parsed by
      AssemblyHelper.GetApplicationBuildDate); GetApplicationVersion strips it before comparison.
    -->
    <Version>3.0.0</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">build$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ValheimServerGUI.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeviceId" Version="6.2.0" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="Semver" Version="2.2.0" />
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\SolutionResources\ClientSecrets.cs" Link="ClientSecrets.cs"
             Condition="'$(Configuration)'=='Release' Or Exists('..\..\SolutionResources\ClientSecrets.cs')" />
    <Compile Include="..\..\SolutionResources\ClientSecrets.Values.cs" Link="ClientSecrets.Values.cs"
             Condition="'$(Configuration)'=='Release' Or Exists('..\..\SolutionResources\ClientSecrets.Values.cs')" />
  </ItemGroup>

</Project>
