<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.AddByIdWindow"
        x:DataType="vm:AddByIdViewModel"
        Title="Add player by ID"
        SizeToContent="WidthAndHeight"
        MinWidth="440" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock TextWrapping="Wrap"
                   Text="Grant access to a player by their platform ID — including friends who have never connected. The player will be granted the selected role for the active profile's save folder." />

        <c:DropdownFormField LabelText="Platform"
                             ItemsSource="{Binding Platforms}"
                             Value="{Binding SelectedPlatform}" />

        <c:TextFormField x:Name="PlayerIdBox"
                         LabelText="Player ID"
                         Watermark="e.g. 76561198000000000"
                         Value="{Binding PlayerId}" />

        <TextBlock Text="Role:" FontWeight="SemiBold" Margin="0,4,0,0" />
        <StackPanel Spacing="4">
            <c:RadioFormField GroupName="AddByIdRole" LabelText="Admin" Value="{Binding IsAdmin}" />
            <c:RadioFormField GroupName="AddByIdRole" LabelText="Banned"
                              IsVisible="{Binding ShowBanned}" Value="{Binding IsBanned}" />
            <c:RadioFormField GroupName="AddByIdRole" LabelText="Permitted (whitelist)"
                              IsVisible="{Binding ShowPermitted}" Value="{Binding IsPermitted}" />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                   Text="Ban and permit changes apply within a few seconds while the server runs; admin changes take effect on the player's next reconnect or a server restart." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
            <Button Content="Add" MinWidth="80" IsDefault="True" IsEnabled="{Binding CanSubmit}" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
