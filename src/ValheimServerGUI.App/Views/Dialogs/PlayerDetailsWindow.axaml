<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.PlayerDetailsWindow"
        x:DataType="vm:PlayerDetailsViewModel"
        Title="Player Details"
        SizeToContent="Height" Width="460" MinWidth="420"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="8">
        <StackPanel Spacing="2">
            <c:LabelField LabelText="Platform:" Value="{Binding Platform}" />
            <c:LabelField LabelText="Player ID:" Value="{Binding PlayerId}">
                <c:LabelField.TrailingContent>
                    <c:CopyButton Text="{Binding PlayerId}" />
                </c:LabelField.TrailingContent>
            </c:LabelField>
            <c:LabelField LabelText="ZDO ID:" Value="{Binding ZdoId}" />
            <c:LabelField LabelText="Latest Character:" Value="{Binding LatestCharacter}" />
            <c:LabelField LabelText="Status:" Value="{Binding Status}" />
        </StackPanel>

        <c:TextFormField LabelText="Display Name" Value="{Binding DisplayName}" MaxLength="64" Margin="0,4,0,0" />

        <c:AddRemoveListField x:Name="CharactersField" LabelText="Known Characters" Margin="0,6,0,0"
                              ItemsSource="{Binding Characters}" Value="{Binding SelectedCharacter, Mode=TwoWay}"
                              ListHeight="120" RemoveCommand="{Binding RemoveCharacterCommand}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
