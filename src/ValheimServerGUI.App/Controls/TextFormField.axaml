<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             x:Class="ValheimServerGUI.App.Controls.TextFormField"
             x:Name="Root" x:CompileBindings="False">
    <c:FormRow Header="{Binding #Root.LabelText}" HelpText="{Binding #Root.HelpText}">
        <Grid ColumnDefinitions="*,Auto">
            <!-- Plain box (no affix): the default for every text field. -->
            <TextBox Grid.Column="0"
                     IsVisible="{Binding #Root.Affix, Converter={x:Static ObjectConverters.IsNull}}"
                     VerticalAlignment="Center"
                     Text="{Binding #Root.Value, Mode=TwoWay}"
                     MaxLength="{Binding #Root.MaxLength}"
                     PlaceholderText="{Binding #Root.Watermark}"
                     AcceptsReturn="{Binding #Root.Multiline}"
                     Height="{Binding #Root.InputHeight}"
                     TextWrapping="{Binding #Root.Multiline, Converter={x:Static conv:BooleanToTextWrappingConverter.Instance}}"
                     VerticalContentAlignment="{Binding #Root.Multiline, Converter={x:Static conv:MultilineToVerticalAlignmentConverter.Instance}}"
                     PasswordChar="{Binding #Root.ShowValue, Converter={x:Static conv:PasswordCharConverter.Instance}}" />

            <!-- Affix box: a chromeless box in the outlined shell, with Affix as a connected end-cap. -->
            <Border Grid.Column="0" Classes="fieldShell"
                    IsVisible="{Binding #Root.Affix, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Classes="chromeless"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                             Text="{Binding #Root.Value, Mode=TwoWay}"
                             MaxLength="{Binding #Root.MaxLength}"
                             PlaceholderText="{Binding #Root.Watermark}"
                             PasswordChar="{Binding #Root.ShowValue, Converter={x:Static conv:PasswordCharConverter.Instance}}" />
                    <ContentControl Grid.Column="1" Content="{Binding #Root.Affix}" VerticalAlignment="Stretch" />
                </Grid>
            </Border>

            <!-- Adornments outside the box (copy button on plain fields, show-password toggle, …). -->
            <ContentControl Grid.Column="1" Content="{Binding #Root.TrailingContent}"
                            IsVisible="{Binding #Root.TrailingContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
    </c:FormRow>
</UserControl>
