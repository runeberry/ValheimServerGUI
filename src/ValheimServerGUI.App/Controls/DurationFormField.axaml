<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             x:Class="ValheimServerGUI.App.Controls.DurationFormField"
             x:Name="Root" x:CompileBindings="False">
    <c:FormRow Header="{Binding #Root.LabelText}" HelpText="{Binding #Root.HelpText}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource LabelMargin}" IsEnabled="{Binding #Root.IsEnabled}">
            <NumericUpDown Grid.Column="0"
                           Value="{Binding #Root.DisplayAmount, Mode=TwoWay}"
                           Minimum="{Binding #Root.NumericMinimum}"
                           Maximum="{Binding #Root.NumericMaximum}"
                           Increment="1" FormatString="0" />
            <!-- Fixed width sized for the longest unit ("Seconds") so it does not resize per selection. -->
            <ComboBox Grid.Column="1" Width="96"
                      ItemsSource="{Binding #Root.Units}"
                      DisplayMemberBinding="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}"
                      SelectedItem="{Binding #Root.SelectedUnit, Mode=TwoWay}" />
        </Grid>
    </c:FormRow>
</UserControl>
