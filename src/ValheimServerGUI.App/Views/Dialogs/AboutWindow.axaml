<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:conv="using:ValheimServerGUI.App.Converters"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels.Dialogs"
        x:Class="ValheimServerGUI.App.Views.Dialogs.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="About"
        SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="24" Spacing="6" HorizontalAlignment="Center">
        <Image Source="avares://ValheimServerGUI.App/Assets/vsg_logo_256.png" Width="72" Height="72"
               HorizontalAlignment="Center" Margin="0,0,0,4"
               RenderOptions.BitmapInterpolationMode="HighQuality" />

        <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" TextAlignment="Center" />

        <StackPanel Spacing="0" HorizontalAlignment="Center" Margin="0,6,0,0">
            <TextBlock Text="{Binding Copyright}" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <TextBlock Text="{Binding License}" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

        <StackPanel Spacing="0" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{Binding BuildDate, StringFormat='Build Date: {0}'}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       IsVisible="{Binding BuildDate, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Classes="link" Command="{Binding OpenGitHubCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:IconImage IconName="GitHubLogo" VerticalAlignment="Center" />
                    <TextBlock Text="GitHub" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="link" Command="{Binding OpenDiscordCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:IconImage IconName="DiscordLogo" VerticalAlignment="Center" />
                    <TextBlock Text="Discord" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="link" Command="{Binding OpenDonateCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:IconImage IconName="DonateLogo" VerticalAlignment="Center" />
                    <TextBlock Text="Donate" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <c:HyperlinkLabel Text="Don't have Valheim yet? Why not? Buy it here!" Margin="0,8,0,0"
                          HorizontalAlignment="Center" TextAlignment="Center"
                          Command="{Binding OpenValheimSiteCommand}" />

        <Button Content="Close" MinWidth="80" HorizontalAlignment="Center" Margin="0,12,0,0"
                IsDefault="True" IsCancel="True" Click="OnClose" />
    </StackPanel>
</Window>
