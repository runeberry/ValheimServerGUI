<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.AdvancedControlsView"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer>
        <Grid Margin="8" ColumnDefinitions="*,8,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <c:GroupBox Header="Directory Overrides (for just this Profile)">
                    <StackPanel Spacing="2">
                        <c:FormRow Header="Valheim Dedicated Server .exe"
                                   HelpText="Leave blank to use the default from Preferences.">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Form.ServerExePath}" IsEnabled="{Binding AllowServerChanges}" />
                                <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0" ToolTip.Tip="Open server folder"
                                        Command="{Binding OpenServerExeFolderCommand}">
                                    <Image Source="{c:Icon OpenFolder_16x}" Width="16" Height="16"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Button>
                            </Grid>
                        </c:FormRow>
                        <c:FormRow Header="Valheim Save Data Folder"
                                   HelpText="Leave blank to use the default from Preferences.">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Form.SaveDataFolderPath}" IsEnabled="{Binding AllowServerChanges}" />
                                <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0" ToolTip.Tip="Open save folder"
                                        Command="{Binding OpenSaveFolderCommand}">
                                    <Image Source="{c:Icon OpenFolder_16x}" Width="16" Height="16"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Button>
                            </Grid>
                        </c:FormRow>
                    </StackPanel>
                </c:GroupBox>

                <c:GroupBox Header="Other Settings">
                    <StackPanel Spacing="4">
                        <CheckBox Content="Start this server when ValheimServerGUI starts"
                                  IsChecked="{Binding Form.AutoStart}" IsEnabled="{Binding AllowServerChanges}" />
                        <CheckBox Content="Write server logs to file"
                                  IsChecked="{Binding Form.WriteServerLogsToFile}" IsEnabled="{Binding AllowServerChanges}" />
                        <c:FormRow Header="Additional Command Line Args"
                                   HelpText="Extra arguments passed to the server (the -logFile argument is not allowed).">
                            <TextBox Text="{Binding Form.AdditionalArgs}" MaxLength="32767" IsEnabled="{Binding AllowServerChanges}" />
                        </c:FormRow>
                    </StackPanel>
                </c:GroupBox>
            </StackPanel>

            <c:GroupBox Grid.Column="2" Header="Saving &amp; Backups" VerticalAlignment="Top">
                <StackPanel Spacing="2" Width="150">
                    <c:FormRow Header="Save Interval" HelpText="How often the world is auto-saved, in seconds (60–86400).">
                        <NumericUpDown Value="{Binding Form.SaveInterval}" Minimum="60" Maximum="86400"
                                       FormatString="0" IsEnabled="{Binding AllowServerChanges}" />
                    </c:FormRow>
                    <c:FormRow Header="Backups" HelpText="Number of world backups to retain (1–1000).">
                        <NumericUpDown Value="{Binding Form.BackupCount}" Minimum="1" Maximum="1000"
                                       FormatString="0" IsEnabled="{Binding AllowServerChanges}" />
                    </c:FormRow>
                    <c:FormRow Header="Short Backup" HelpText="Short backup interval, in seconds (300–2592000).">
                        <NumericUpDown Value="{Binding Form.BackupIntervalShort}" Minimum="300" Maximum="2592000"
                                       FormatString="0" IsEnabled="{Binding AllowServerChanges}" />
                    </c:FormRow>
                    <c:FormRow Header="Long Backup" HelpText="Long backup interval, in seconds (300–2592000).">
                        <NumericUpDown Value="{Binding Form.BackupIntervalLong}" Minimum="300" Maximum="2592000"
                                       FormatString="0" IsEnabled="{Binding AllowServerChanges}" />
                    </c:FormRow>
                </StackPanel>
            </c:GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
