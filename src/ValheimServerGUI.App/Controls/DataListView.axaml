<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cui="urn:caprilyn:ui"
                    xmlns:c="using:ValheimServerGUI.App.Controls">

    <!-- The shared data table: an inner DataGrid (PART_Grid) with an optional compact footer bar below it. The frame is the
         grid's own body (the DataGrid.Container element), drawn around both, so the footer sits inside it; the inner grid draws
         no edge of its own. The footer hosts action icon buttons anchored left and/or right and only appears when a slot is
         filled (HasFooter); it wears the grid's header band (DataGrid.Header), at the header's height. -->
    <ControlTheme x:Key="{x:Type c:DataListView}" TargetType="c:DataListView">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Classes="lit"
                        Background="{DynamicResource DataGridContainerFillMiddleBrush}"
                        BorderBrush="{DynamicResource DataGridContainerEdgeBrush}"
                        CornerRadius="{DynamicResource DataGridContainerCornerRadius}"
                        cui:PixelSnap.BorderThickness="{DynamicResource HairlineThickness}"
                        cui:PixelSnap.BoxShadow="{DynamicResource DataGridContainerShadow}">
                    <!-- Clipped to the edge's rounded corners, so the square header and footer meet them cleanly. -->
                    <Border CornerRadius="{DynamicResource DataGridContainerCornerRadius}" ClipToBounds="True">
                        <DockPanel>
                            <!-- Footer: the header band's look and height, content centred. -->
                            <Border DockPanel.Dock="Bottom" IsVisible="{TemplateBinding HasFooter}" Classes="lit"
                                    Background="{DynamicResource DataGridHeaderFillBrush}"
                                    BorderBrush="{DynamicResource DataGridHeaderEdgeBrush}"
                                    cui:PixelSnap.BorderThickness="0,1,0,0"
                                    Height="{x:Static c:DataListView.HeaderFooterHeight}" Padding="6,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <ContentControl Grid.Column="0" Content="{TemplateBinding FooterLeft}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <ContentControl Grid.Column="2" Content="{TemplateBinding FooterRight}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- EmptyText overlays the rows area (below the header), centred and italic. -->
                            <Panel>
                                <DataGrid Name="PART_Grid" BorderThickness="0" CornerRadius="0" />
                                <TextBlock Name="PART_EmptyText" Text="{TemplateBinding EmptyText}"
                                           IsVisible="{TemplateBinding EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Margin="{x:Static c:DataListView.EmptyTextMargin}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" FontStyle="Italic"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource DataGridRowTextSecondaryBrush}" />
                            </Panel>
                        </DockPanel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
