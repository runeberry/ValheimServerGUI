<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.PlayersView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
            <Button Grid.Column="0" Content="View Player Details…" Command="{Binding Players.ViewDetailsCommand}" />
            <c:HyperlinkLabel Grid.Column="2" Text="Character names wrong? Click here."
                              Command="{Binding CharacterNamesHelpCommand}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <c:IconButton Grid.Column="3" IconName="Cancel_16x" ToolTip.Tip="Remove player"
                          Command="{Binding Players.RemoveCommand}" />
        </Grid>

        <c:DataListView ItemsSource="{Binding Players.Players}"
                        SelectedItem="{Binding Players.SelectedPlayer}">
            <c:DataListView.Styles>
                <Style Selector="DataGridRow" x:DataType="vm:PlayerRowViewModel">
                    <Setter Property="Opacity"
                            Value="{Binding IsOffline, Converter={x:Static conv:OfflineOpacityConverter.Instance}}" />
                </Style>
            </c:DataListView.Styles>
            <c:DataListView.Columns>
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PlayerRowViewModel">
                            <Image Source="{Binding PlatformIcon}" Width="16" Height="16"
                                   Margin="6,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Player (Character)" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto" />
                <DataGridTextColumn Header="Since" Binding="{Binding SinceText}" Width="Auto" />
            </c:DataListView.Columns>
        </c:DataListView>
    </DockPanel>
</UserControl>
