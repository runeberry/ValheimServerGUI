<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ValheimServerGUI.App.ViewModels"
        xmlns:conv="using:ValheimServerGUI.App.Converters"
        xmlns:c="using:ValheimServerGUI.App.Controls"
        xmlns:tabs="using:ValheimServerGUI.App.Views.Tabs"
        mc:Ignorable="d"
        x:Class="ValheimServerGUI.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Width="550" Height="408"
        MinWidth="550" MinHeight="408"
        Title="{Binding Title}">

    <Window.Resources>
        <!-- WinForms-style tab strip: bordered folder tabs, used only by this window's TabControl so the
             theme is owned here rather than a global stock override. Inactive tabs sit recessed on the app
             background; the selected tab is raised, painted the content colour, and merges into the content
             frame (no bottom border, overlapping the frame's top edge). Colours come from Palette.axaml. -->
        <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Background" Value="{DynamicResource LayerBase}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4,4,0,0"
                            Margin="0,2,-1,0">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- Selected: content-coloured + raised (no top push-down), no bottom border, overlapping the
                 content frame by 1px so it blends into the content. Horizontal padding is unchanged, so the
                 title never shifts sideways between states. -->
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource LayerContent}" />
                <Setter Property="BorderThickness" Value="1,1,1,0" />
                <Setter Property="Margin" Value="0,0,-1,-1" />
            </Style>

            <Style Selector="^:pointerover:not(:selected) /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource LayerBaseHover}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource LayerContent}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <!-- Tab strip; pulled down 1px so the selected tab overlaps the content frame border. -->
                        <ItemsPresenter Name="PART_ItemsPresenter" DockPanel.Dock="Top" ZIndex="1"
                                        Margin="0,0,0,-1"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                        <Border Background="{DynamicResource LayerContent}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0,3,3,3">
                            <ContentPresenter Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Menu ===== -->
        <!-- Bottom hairline mirrors the footer's top border so the menu bar reads as a banded strip. -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}">
        <DockPanel>
        <!-- Right of the menu: a label-less profile picker + Start/Restart/Stop controls, turning the strip
             into a single-window multi-profile control panel. The controls bind the same VM commands as the
             Server Controls tab and the tray, so their enablement is derived from the selected server. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3"
                    VerticalAlignment="Center" Margin="6,0,6,0">
            <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,4,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <c:DropdownFormField x:Name="ProfileDropdown" Width="170" VerticalAlignment="Center"
                                 ItemsSource="{Binding Profiles}" />
            <c:IconButton IconName="Run_16x" ToolTip.Tip="Start Server" Command="{Binding StartCommand}" />
            <c:IconButton IconName="Restart_16x" ToolTip.Tip="Restart Server" Command="{Binding RestartCommand}" />
            <c:IconButton IconName="Stop_16x" ToolTip.Tip="Stop Server" Command="{Binding StopCommand}" />
        </StackPanel>
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="New _Window" Command="{Binding NewWindowCommand}">
                    <MenuItem.Icon><c:IconImage IconName="AddImmediateWindow_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New _Profile" Command="{Binding NewProfileCommand}">
                    <MenuItem.Icon><c:IconImage IconName="NewFile_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Save Profile" Command="{Binding SaveProfileCommand}">
                    <MenuItem.Icon><c:IconImage IconName="Save_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save Profile _As…" Command="{Binding SaveProfileAsCommand}">
                    <MenuItem.Icon><c:IconImage IconName="Save_16x" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Load Profile" ItemsSource="{Binding Profiles}"
                          IsEnabled="{Binding HasProfiles}" x:CompileBindings="False">
                    <MenuItem.Icon><c:IconImage IconName="OpenFile_16x" /></MenuItem.Icon>
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <MenuItem Header="_Remove Profile" ItemsSource="{Binding Profiles}"
                          IsEnabled="{Binding HasProfiles}" x:CompileBindings="False">
                    <MenuItem.Icon><c:IconImage IconName="Cancel_16x" /></MenuItem.Icon>
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem">
                            <Setter Property="Command"
                                    Value="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Preferences…" Command="{Binding PreferencesCommand}">
                    <MenuItem.Icon><c:IconImage IconName="Settings_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set _Directories…" Command="{Binding SetDirectoriesCommand}">
                    <MenuItem.Icon><c:IconImage IconName="FolderInformation_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open Settings Directory…" Command="{Binding OpenSettingsDirectoryCommand}">
                    <MenuItem.Icon><c:IconImage IconName="OpenFolder_16x" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Close" Command="{Binding CloseCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Online _Manual" Command="{Binding OnlineManualCommand}">
                    <MenuItem.Icon><c:IconImage IconName="OpenWeb_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Port Forwarding" Command="{Binding PortForwardingCommand}">
                    <MenuItem.Icon><c:IconImage IconName="OpenWeb_16x" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Submit a _Bug Report…" Command="{Binding BugReportCommand}">
                    <MenuItem.Icon><c:IconImage IconName="NewBug_16x" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Check for _Updates" Command="{Binding CheckForUpdatesCommand}">
                    <MenuItem.Icon><c:IconImage IconName="UnsyncedCommits_16x_Horiz" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Get support in _Discord" Command="{Binding DiscordCommand}">
                    <MenuItem.Icon><c:IconImage IconName="DiscordLogo" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_About…" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>
        </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Background="{DynamicResource LayerDarkest}"
                BorderBrush="{DynamicResource AppBorderBrush}" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Width="16" Height="16" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Source="{Binding ServerStatus, Converter={x:Static conv:ServerStatusToIconConverter.Instance}}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Icon + text always render at full contrast; only the text turns into a clickable link
                     when there is somewhere to go (UpdateIsLink). Previously the whole readout was a Button
                     that went disabled when not a link, dimming the icon and text to near-invisibility. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Image Width="16" Height="16" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Source="{Binding UpdateStatus, Converter={x:Static conv:UpdateStatusToIconConverter.Instance}}" />
                    <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center"
                               IsVisible="{Binding UpdateIsLink, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                    <c:HyperlinkLabel Text="{Binding UpdateStatusText}" VerticalAlignment="Center"
                                      Command="{Binding UpdateLinkCommand}" IsVisible="{Binding UpdateIsLink}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Tabs ===== -->
        <TabControl Margin="8" x:Name="Tabs" SelectionChanged="OnTabChanged">
            <TabItem Header="Server Controls">
                <tabs:ServerControlsView />
            </TabItem>
            <TabItem Header="Advanced Controls">
                <tabs:AdvancedControlsView />
            </TabItem>
            <TabItem Header="Server Details" x:Name="DetailsTab">
                <tabs:ServerDetailsView />
            </TabItem>
            <TabItem Header="Players" x:Name="PlayersTab">
                <tabs:PlayersView />
            </TabItem>
            <TabItem Header="Logs">
                <tabs:LogsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
