<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ValheimServerGUI.App.Views.Dialogs.UnsavedChangesWindow"
        Title="Unsaved changes"
        SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="480"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock TextWrapping="Wrap" Text="You have unsaved changes. Save them before closing?" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Content="Save" MinWidth="80" IsDefault="True" Click="OnSave" />
            <Button Content="Don't Save" MinWidth="80" Click="OnDiscard" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
