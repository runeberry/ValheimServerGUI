<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ValheimServerGUI.Localization"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.Tabs.LogsView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Logs_ViewFor_Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <c:DropdownFormField Grid.Column="1" MinWidth="140" VerticalAlignment="Center"
                                 ItemsSource="{Binding Logs.Views}" Value="{Binding Logs.SelectedView}" />
            <c:OpenButton Grid.Column="2" Margin="4,0,0,0" ToolTip.Tip="{x:Static loc:Strings.Logs_OpenFolder_Tip}"
                          Command="{Binding Logs.OpenLogsFolderCommand}" />
            <Button Grid.Column="4" Content="{x:Static loc:Strings.Logs_SaveLogs}" Command="{Binding Logs.SaveLogsCommand}" Margin="4,0,0,0" />
            <Button Grid.Column="5" Content="{x:Static loc:Strings.Logs_ClearLogs}" Command="{Binding Logs.ClearLogsCommand}" Margin="4,0,0,0" />
        </Grid>

        <c:LogViewer ItemsSource="{Binding Logs.CurrentLines}" />
    </DockPanel>
</UserControl>
