<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ValheimServerGUI.App.Views.Dialogs.MessageWindow"
        SizeToContent="WidthAndHeight"
        MinWidth="360" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="MessageText" TextWrapping="Wrap" />
        <Button Grid.Row="1" Content="OK" MinWidth="80" HorizontalAlignment="Center"
                Margin="0,20,0,0" IsDefault="True" IsCancel="True" Click="OnOk" />
    </Grid>
</Window>
