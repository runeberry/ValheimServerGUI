<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ValheimServerGUI.Localization"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             xmlns:conv="using:ValheimServerGUI.App.Converters"
             xmlns:vm="using:ValheimServerGUI.App.ViewModels"
             x:Class="ValheimServerGUI.App.Views.KnownCharactersView"
             x:DataType="vm:KnownCharactersViewModel"
             x:Name="Root">

    <!-- The Known Characters table (one per Manage Players tab). Add/Rename open a text prompt owned by the
         hosting window, so those commands are wired in code-behind; Remove is a VM command. -->
    <c:DataListView x:Name="CharactersListView" ItemsSource="{Binding Characters}"
                    SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                    EmptyText="{Binding EmptyText}">
        <c:DataListView.RowContextMenu>
            <ContextMenu>
                <MenuItem x:Name="RenameCharacterMenuItem" Header="{x:Static loc:Strings.KnownCharacters_Menu_Rename}" />
                <MenuItem Header="{x:Static loc:Strings.KnownCharacters_Menu_Remove}" Command="{Binding RemoveCharacterCommand}" />
            </ContextMenu>
        </c:DataListView.RowContextMenu>
        <c:DataListView.Columns>
            <DataGridTemplateColumn Header="{x:Static loc:Strings.KnownCharacters_Column_Name}" Width="*" SortMemberPath="CharacterName">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:CharacterRowViewModel">
                        <TextBlock Text="{Binding CharacterName}" VerticalAlignment="Center" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Status glyph + text; only the active character is ever non-Offline. -->
            <DataGridTemplateColumn Header="{x:Static loc:Strings.KnownCharacters_Column_Status}" Width="Auto" SortMemberPath="StatusText">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:CharacterRowViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Image Width="16" Height="16" VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Source="{Binding Status, Converter={x:Static conv:PlayerStatusToIconConverter.Instance}}" />
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Blank for characters recorded before the last-seen field existed. -->
            <DataGridTemplateColumn Header="{x:Static loc:Strings.KnownCharacters_Column_Since}" Width="Auto" SortMemberPath="LastSeen">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:CharacterRowViewModel">
                        <TextBlock Text="{Binding SinceText}" VerticalAlignment="Center" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </c:DataListView.Columns>
        <c:DataListView.FooterLeft>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:IconButton x:Name="AddCharacterButton" IconName="Add_16x" ToolTip.Tip="{x:Static loc:Strings.KnownCharacters_Add_Tip}" />
                <c:IconButton x:Name="EditCharacterButton" IconName="Edit_16x" ToolTip.Tip="{x:Static loc:Strings.KnownCharacters_Rename_Tip}" />
                <c:IconButton IconName="Cancel_16x" ToolTip.Tip="{x:Static loc:Strings.KnownCharacters_Remove_Tip}"
                              Command="{Binding RemoveCharacterCommand}" />
            </StackPanel>
        </c:DataListView.FooterLeft>
    </c:DataListView>
</UserControl>
