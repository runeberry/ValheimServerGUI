# The Ubuntu cloud image the Linux reboot-test desktop image starts from (scripts/validate-reboot-linux.sh).
# Sourceable by bash. A dated release, so the image only changes when this file does; to update, pick a newer
# release folder from https://cloud-images.ubuntu.com/releases/noble/ and copy the image's line from its SHA256SUMS.
UBUNTU_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260926/ubuntu-24.04-server-cloudimg-amd64.img
UBUNTU_IMAGE_SHA256=6a81c37564db9b1ee84e141922625e1d7c5b389b99bb3c572e0243607d5bb4d2
