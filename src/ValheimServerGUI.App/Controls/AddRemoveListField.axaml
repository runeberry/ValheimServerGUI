<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ValheimServerGUI.App.Controls"
             x:Class="ValheimServerGUI.App.Controls.AddRemoveListField"
             x:Name="Root" x:CompileBindings="False">
    <StackPanel Spacing="6">
        <c:SelectListField LabelText="{Binding #Root.LabelText}" HelpText="{Binding #Root.HelpText}"
                           ItemsSource="{Binding #Root.ItemsSource}"
                           Value="{Binding #Root.Value, Mode=TwoWay}"
                           ListHeight="{Binding #Root.ListHeight}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <c:IconButton IconName="Add_16x" ToolTip.Tip="Add"
                          Command="{Binding #Root.AddCommand}" IsEnabled="{Binding #Root.AddEnabled}" />
            <c:IconButton IconName="Edit_16x" ToolTip.Tip="Rename"
                          Command="{Binding #Root.EditCommand}" IsEnabled="{Binding #Root.EditEnabled}" />
            <c:IconButton IconName="Cancel_16x" ToolTip.Tip="Remove"
                          Command="{Binding #Root.RemoveCommand}" IsEnabled="{Binding #Root.RemoveEnabled}" />
        </StackPanel>
    </StackPanel>
</UserControl>
